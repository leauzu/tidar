---
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isRoute = (path) => currentPath === path || currentPath.startsWith(`${path}/`) || currentPath.startsWith(`${path}-`);
const aboutOpen = ['/profil','/visi-misi','/tugas-fungsi','/makna-lambang','/dokumen-resmi'].some(isRoute);
const leadershipOpen = ['/ketua-umum','/sekretaris-jenderal','/bendahara-umum'].some(isRoute);
const mediaOpen = isRoute('/mars-hymne');
---
<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <a aria-label="TIDAR — Beranda" class="brand" href="/"><img alt="TIDAR — Tunas Indonesia Raya" src="/assets/cropped-logo-tidar-banner-1.png"/></a>
    <button aria-controls="mainNav" aria-expanded="false" aria-label="Buka menu" class="menu-toggle" id="menuToggle" type="button"><span></span><span></span><span></span></button>
    <nav aria-label="Navigasi utama" class="main-nav" id="mainNav">
      <div class="nav-shell">
        <div class="nav-mobile-head"><img alt="TIDAR" src="/assets/cropped-logo-tidar-banner-1.png"/><button aria-label="Tutup menu" class="mobile-nav-close" id="mobileNavClose" type="button">×</button></div>
        <div class="nav-groups">
          <div class:list={["nav-group", {"is-current": aboutOpen}]}>
            <button aria-expanded="false" class:list={["nav-parent", {"is-active": aboutOpen}]} type="button">Tentang TIDAR</button>
            <div class="nav-dropdown">
              <a class:list={{"is-active": isRoute('/profil')}} aria-current={isRoute('/profil') ? 'page' : undefined} href="/profil">Profil</a>
              <a class:list={{"is-active": isRoute('/visi-misi')}} aria-current={isRoute('/visi-misi') ? 'page' : undefined} href="/visi-misi">Visi Misi</a>
              <a class:list={{"is-active": isRoute('/tugas-fungsi')}} aria-current={isRoute('/tugas-fungsi') ? 'page' : undefined} href="/tugas-fungsi">Tugas &amp; Fungsi</a>
              <a class:list={{"is-active": isRoute('/makna-lambang')}} aria-current={isRoute('/makna-lambang') ? 'page' : undefined} href="/makna-lambang">Makna Lambang</a>
              <a class:list={{"is-active": isRoute('/dokumen-resmi')}} aria-current={isRoute('/dokumen-resmi') ? 'page' : undefined} href="/dokumen-resmi">Dokumen Resmi</a>
            </div>
          </div>
          <div class:list={["nav-group", {"is-current": leadershipOpen}]}>
            <button aria-expanded="false" class:list={["nav-parent", {"is-active": leadershipOpen}]} type="button">Profil Pimpinan</button>
            <div class="nav-dropdown">
              <a class:list={{"is-active": isRoute('/ketua-umum')}} aria-current={isRoute('/ketua-umum') ? 'page' : undefined} href="/ketua-umum">Ketua Umum</a>
              <a class:list={{"is-active": isRoute('/sekretaris-jenderal')}} aria-current={isRoute('/sekretaris-jenderal') ? 'page' : undefined} href="/sekretaris-jenderal">Sekretaris Jenderal</a>
              <a class:list={{"is-active": isRoute('/bendahara-umum')}} aria-current={isRoute('/bendahara-umum') ? 'page' : undefined} href="/bendahara-umum">Bendahara Umum</a>
            </div>
          </div>
          <div class:list={["nav-group", "nav-group--single", {"is-current": isRoute('/pengurus-pusat')}]}><a class:list={["nav-parent", "nav-parent-link", {"is-active": isRoute('/pengurus-pusat')}]} aria-current={isRoute('/pengurus-pusat') ? 'page' : undefined} href="/pengurus-pusat">Pengurus Pusat</a></div>
          <div class:list={["nav-group", "nav-group--single", {"is-current": isRoute('/berita')}]}><a class:list={["nav-parent", "nav-parent-link", {"is-active": isRoute('/berita')}]} aria-current={isRoute('/berita') ? 'page' : undefined} href="/berita">Berita</a></div>
          <div class:list={["nav-group", {"is-current": mediaOpen}]}>
            <button aria-expanded="false" class:list={["nav-parent", {"is-active": mediaOpen}]} type="button">Media</button>
            <div class="nav-dropdown"><a href="https://bukuprabowo.com/" rel="noopener" target="_blank">Buku Prabowo <svg aria-hidden="true" class="external-arrow" focusable="false" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><path d="M4 12 12 4M6 4h6v6"/></svg></a><a class:list={{"is-active": mediaOpen}} aria-current={mediaOpen ? 'page' : undefined} href="/mars-hymne">Mars &amp; Himne</a></div>
          </div>
        </div>
      </div>
    </nav>
    <div class="header-actions"><a class="btn btn-ghost" href="https://tidarmendengar.com" rel="noopener" target="_blank">TIDAR Mendengar</a><a class="btn btn-primary" href="https://wa.me/6285211891079?text=Halo+bro%2Fsis" rel="noopener" target="_blank">Ayo Daftar <span><svg aria-hidden="true" class="external-arrow" focusable="false" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><path d="M4 12 12 4M6 4h6v6"/></svg></span></a></div>
  </div>
</header>
