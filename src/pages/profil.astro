---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title={"Profil — TIDAR"} description={"Profil organisasi Tunas Indonesia Raya"} bodyClass={"inner-page profile-page logo-page"} extraCss={["/pages.css"]}>
<Fragment slot="head">
<style is:global>

/* Scoped profile page redesign. Header, navigation, global CTA, and footer remain untouched. */
.profile-redesign-main{padding-top:86px;background:#f7f5f1;color:#171717;overflow:hidden}
.profile-redesign-main img{user-select:none}
.profile-redesign-shell{width:min(calc(100% - 48px),1240px);margin-inline:auto}
.profile-redesign-hero{position:relative;min-height:470px;display:flex;align-items:center;overflow:hidden;background:#d71920;border-radius:0 0 0 82px;border-bottom:6px solid #f4b220;color:#fff;isolation:isolate}
.profile-redesign-hero::before{content:"";position:absolute;inset:0;background-image:url('/assets/profil-hero.webp');background-position:center 53%;background-size:cover;z-index:-3;filter:saturate(.92) contrast(1.02)}
.profile-redesign-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(202,0,12,.98) 0%,rgba(215,25,32,.93) 40%,rgba(215,25,32,.45) 65%,rgba(114,0,4,.08) 100%),linear-gradient(0deg,rgba(91,0,4,.22),transparent 54%);z-index:-2}
.profile-redesign-hero__pattern{position:absolute;left:34px;bottom:28px;width:96px;height:56px;opacity:.72;background-image:radial-gradient(circle,#f4b220 1.4px,transparent 1.6px);background-size:10px 10px}
.profile-redesign-hero__content{width:min(calc(100% - 64px),1240px);margin-inline:auto;padding:74px 0 64px;position:relative;z-index:1}
.profile-redesign-eyebrow{margin:0 0 12px;color:#f4b220;font-size:.76rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.profile-redesign-hero h1{margin:0;max-width:620px;font-family:var(--display);font-size:clamp(4.3rem,7vw,7rem);font-weight:800;letter-spacing:-.025em;line-height:.86;text-transform:uppercase}
.profile-redesign-title-rule{display:block;width:66px;height:4px;margin:20px 0 20px;background:#f4b220}
.profile-redesign-hero__lead{max-width:500px;margin:0;color:rgba(255,255,255,.94);font-size:1.05rem;line-height:1.7;font-weight:500}
.profile-redesign-content{padding:38px 0 76px}
.profile-redesign-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,.82fr);gap:30px;align-items:stretch}
.profile-redesign-copy{padding:8px 4px}
.profile-redesign-label{margin:0 0 8px;color:#ed1c24;font-size:.73rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
.profile-redesign-copy h2,.profile-five-copy h2{margin:0;font-size:clamp(1.75rem,2.7vw,2.45rem);line-height:1.25;letter-spacing:-.025em}
.profile-redesign-copy>p:last-child,.profile-five-copy>p:last-child{margin:18px 0 0;color:#4f4f4f;font-size:.98rem;line-height:1.78}
.profile-redesign-logo-card{position:relative;min-height:270px;border-radius:28px;background:#ece9e4;box-shadow:0 12px 34px rgba(31,31,31,.10);overflow:hidden;isolation:isolate}
.profile-redesign-logo-card::before{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(17,17,17,.10))}
.profile-redesign-logo-card::after{content:"";position:absolute;right:18px;bottom:18px;z-index:3;width:82px;height:58px;border-radius:12px;background-color:rgba(255,255,255,.84);background-image:radial-gradient(circle,#e7a417 1.5px,transparent 1.8px);background-size:10px 10px;box-shadow:0 10px 24px rgba(20,20,20,.10);opacity:.96}
.profile-redesign-logo-card img{position:absolute;inset:0;z-index:1;width:100%;height:100%;object-fit:cover;object-position:center}
.profile-redesign-pillars{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:20px}
.profile-redesign-pillar{position:relative;min-height:300px;padding:28px 24px 24px;text-align:center;border:1px solid rgba(23,23,23,.07);border-radius:23px;background:#fff;box-shadow:0 9px 26px rgba(23,23,23,.07);transition:transform .25s ease,box-shadow .25s ease}
.profile-redesign-pillar:hover{transform:translateY(-5px);box-shadow:0 18px 38px rgba(23,23,23,.11)}
.profile-redesign-number{position:absolute;left:16px;top:16px;display:grid;place-items:center;min-width:42px;height:42px;padding:0 9px;border-radius:10px;background:#ed1c24;color:#fff;font-weight:900;font-size:.8rem;box-shadow:0 8px 16px rgba(237,28,36,.24)}
.profile-redesign-pillar img{width:64px;height:64px;object-fit:contain;margin:9px auto 14px}
.profile-redesign-pillar h3{margin:0;font-family:var(--display);font-size:1.75rem;line-height:.98;text-transform:uppercase}
.profile-redesign-pillar p{max-width:290px;margin:14px auto 0;color:#555;font-size:.89rem;line-height:1.65}
.profile-redesign-pillar::after{content:"";display:block;width:28px;height:2px;margin:18px auto 0;background:#d99a16}
.profile-redesign-roles{margin-top:22px;padding:25px 22px 22px;border:1px solid rgba(23,23,23,.07);border-radius:24px;background:linear-gradient(135deg,#fff 0%,#fbf6ed 100%);box-shadow:0 10px 30px rgba(23,23,23,.055)}
.profile-redesign-roles__grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin-top:14px}
.profile-redesign-role{position:relative;padding:8px 18px 6px;text-align:center}
.profile-redesign-role:not(:last-child){border-right:1px solid rgba(23,23,23,.13)}
.profile-redesign-role__icon{display:grid;place-items:center;width:72px;height:72px;margin:0 auto 11px;border-radius:50%;background:#fff7e9}
.profile-redesign-role__icon img{width:47px;height:47px;object-fit:contain}
.profile-redesign-role h3{margin:0;font-size:.88rem;line-height:1.35}
.profile-redesign-role p{margin:9px auto 0;color:#5f5f5f;font-size:.78rem;line-height:1.55}
.profile-five{margin-top:24px;padding:18px;border:1px solid rgba(23,23,23,.07);border-radius:26px;background:#fff;box-shadow:0 10px 32px rgba(23,23,23,.065)}
.profile-five-intro{display:grid;grid-template-columns:minmax(0,.95fr) minmax(350px,1.05fr);gap:24px;align-items:stretch}
.profile-five-copy{padding:8px 0 4px 4px;align-self:center}
.profile-five-banner{position:relative;display:grid;place-items:center;min-height:210px;padding:26px;border:1px solid rgba(215,25,32,.08);border-radius:20px;background:linear-gradient(135deg,#f5efe3 0%,#fff 50%,#efe3cd 100%);overflow:hidden}
.profile-five-banner::before{content:"";position:absolute;left:18px;top:18px;width:80px;height:52px;background-image:radial-gradient(circle,#d71920 1.35px,transparent 1.7px);background-size:9px 9px;opacity:.42}
.profile-five-banner::after{content:"";position:absolute;right:18px;bottom:18px;width:78px;height:52px;background-image:radial-gradient(circle,#e7a417 1.4px,transparent 1.7px);background-size:9px 9px;opacity:.62}
.profile-five-banner img{position:relative;z-index:1;width:min(76%,390px);height:160px;object-fit:contain;filter:drop-shadow(0 12px 16px rgba(80,55,10,.12))}
.profile-five-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-top:14px}
.profile-five-card{position:relative;min-height:280px;padding:20px 13px 18px;text-align:center;border:1px solid rgba(23,23,23,.075);border-radius:18px;background:linear-gradient(180deg,#fff,#fefefe);box-shadow:0 7px 20px rgba(23,23,23,.055);transition:transform .24s ease,box-shadow .24s ease}
.profile-five-card:hover{transform:translateY(-4px);box-shadow:0 15px 30px rgba(23,23,23,.09)}
.profile-five-card .profile-redesign-number{left:10px;top:10px;min-width:34px;height:34px;border-radius:8px;font-size:.68rem}
.profile-five-card img{width:60px;height:60px;margin:2px auto 13px;object-fit:contain}
.profile-five-card h3{margin:0;font-family:var(--display);font-size:1.32rem;line-height:1;text-transform:uppercase}
.profile-five-card p{margin:12px auto 0;color:#555;font-size:.77rem;line-height:1.58}
@media(max-width:1050px){
  .profile-redesign-intro,.profile-five-intro{grid-template-columns:1fr 1fr}
  .profile-redesign-roles__grid{grid-template-columns:repeat(3,1fr);gap:18px 0}
  .profile-redesign-role:nth-child(3){border-right:0}
  .profile-redesign-role:nth-child(n+4){border-top:1px solid rgba(23,23,23,.10);padding-top:22px}
  .profile-redesign-role:nth-child(4){grid-column:1/2}
  .profile-redesign-role:nth-child(5){grid-column:2/4}
  .profile-five-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:900px){
  .profile-redesign-main{padding-top:var(--header-h)}
  .profile-redesign-hero{min-height:430px;border-radius:0 0 0 58px}
  .profile-redesign-hero::after{background:linear-gradient(90deg,rgba(202,0,12,.96),rgba(215,25,32,.77) 58%,rgba(122,0,5,.20)),linear-gradient(0deg,rgba(91,0,4,.25),transparent 54%)}
  .profile-redesign-hero__content{width:min(calc(100% - 48px),1240px);padding:64px 0 54px}
  .profile-redesign-hero h1{max-width:560px}
  .profile-redesign-intro{grid-template-columns:1fr}
  .profile-redesign-logo-card{min-height:240px}
  .profile-redesign-pillars{grid-template-columns:1fr 1fr}
  .profile-redesign-pillar:last-child{grid-column:1/-1}
  .profile-five-intro{grid-template-columns:1fr}
  .profile-five-banner{min-height:190px}
  .profile-five-grid{grid-template-columns:1fr 1fr}
  .profile-five-card:last-child{grid-column:1/-1}
}
@media(max-width:620px){
  .profile-redesign-main{padding-top:var(--header-h)}
  .profile-redesign-shell{width:min(calc(100% - 28px),1240px)}
  .profile-redesign-hero{min-height:360px;border-bottom-width:4px;border-radius:0 0 0 40px}
  .profile-redesign-hero::before{background-position:center 50%}
  .profile-redesign-hero::after{background:linear-gradient(90deg,rgba(201,0,11,.96) 0%,rgba(215,25,32,.83) 60%,rgba(150,0,5,.38) 100%),linear-gradient(0deg,rgba(75,0,3,.24),transparent 65%)}
  .profile-redesign-hero__content{width:calc(100% - 34px);padding:42px 0 38px}
  .profile-redesign-eyebrow{font-size:.67rem;margin-bottom:8px}
  .profile-redesign-hero h1{font-size:clamp(3.2rem,16vw,4.6rem);max-width:320px}
  .profile-redesign-title-rule{width:48px;height:3px;margin:14px 0}
  .profile-redesign-hero__lead{max-width:300px;font-size:.88rem;line-height:1.6}
  .profile-redesign-hero__pattern{left:18px;bottom:16px;width:68px;height:40px;background-size:8px 8px}
  .profile-redesign-content{padding:24px 0 52px}
  .profile-redesign-intro{gap:18px}
  .profile-redesign-copy{padding:0 4px}
  .profile-redesign-copy h2,.profile-five-copy h2{font-size:1.72rem}
  .profile-redesign-copy>p:last-child,.profile-five-copy>p:last-child{font-size:.88rem;line-height:1.72;margin-top:13px}
  .profile-redesign-logo-card{min-height:210px;border-radius:21px}
  .profile-redesign-logo-card::after{right:13px;bottom:13px;width:68px;height:48px}
  .profile-redesign-pillars{grid-template-columns:1fr;gap:12px;margin-top:15px}
  .profile-redesign-pillar,.profile-redesign-pillar:last-child{grid-column:auto;min-height:0;padding:24px 20px 20px}
  .profile-redesign-pillar img{width:58px;height:58px}
  .profile-redesign-pillar h3{font-size:1.55rem}
  .profile-redesign-pillar p{font-size:.84rem}
  .profile-redesign-number{left:13px;top:13px;min-width:38px;height:38px}
  .profile-redesign-roles{padding:21px 14px 14px;border-radius:20px}
  .profile-redesign-roles__grid{grid-template-columns:1fr 1fr;gap:0;margin-top:9px}
  .profile-redesign-role{padding:16px 12px;border-top:1px solid rgba(23,23,23,.10)!important;border-right:0!important}
  .profile-redesign-role:nth-child(odd){border-right:1px solid rgba(23,23,23,.10)!important}
  .profile-redesign-role:nth-child(-n+2){border-top:0!important}
  .profile-redesign-role:nth-child(4),.profile-redesign-role:nth-child(5){grid-column:auto}
  .profile-redesign-role:last-child{grid-column:1/-1;border-right:0!important}
  .profile-redesign-role__icon{width:62px;height:62px}
  .profile-redesign-role__icon img{width:42px;height:42px}
  .profile-redesign-role p{font-size:.75rem}
  .profile-five{padding:14px;border-radius:21px}
  .profile-five-copy{padding:2px 3px 0}
  .profile-five-banner{min-height:155px;padding:18px;border-radius:17px}
  .profile-five-banner img{width:min(86%,320px);height:125px}
  .profile-five-grid{grid-template-columns:1fr;gap:10px}
  .profile-five-card,.profile-five-card:last-child{grid-column:auto;min-height:0;padding:21px 18px 19px}
  .profile-five-card img{width:58px;height:58px}
  .profile-five-card h3{font-size:1.45rem}
  .profile-five-card p{font-size:.82rem}
}

</style>
</Fragment>
<main class="profile-redesign-main" id="main"><section aria-labelledby="mlHeroTitle" class="ml-hero">
<div aria-hidden="true" class="ml-hero-shape">
<svg focusable="false" preserveaspectratio="none" viewbox="0 0 1600 560">
<defs>
<lineargradient id="mlHeroRedGradient" x1="0" x2="1" y1="0" y2="1">
<stop offset="0" stop-color="#ef101c"></stop>
<stop offset="0.48" stop-color="#e20d19"></stop>
<stop offset="1" stop-color="#c80712"></stop>
</lineargradient>
<pattern height="22" id="mlHeroDotPattern" patternunits="userSpaceOnUse" width="22">
<circle cx="3" cy="3" fill="#ffffff" fill-opacity="0.14" r="1.7"></circle>
</pattern>
</defs>
<path class="ml-hero-shape-red" d="M0 0H1145C1112 105 1075 215 1028 326C975 450 905 535 760 560H0Z" fill="url(#mlHeroRedGradient)"></path>
<path class="ml-hero-shape-dots" d="M0 0H1145C1112 105 1075 215 1028 326C975 450 905 535 760 560H0Z" fill="url(#mlHeroDotPattern)"></path>
<path class="ml-hero-shape-edge" d="M1145 0C1112 105 1075 215 1028 326C975 450 905 535 760 560" fill="none"></path>
</svg>
</div>
<div aria-hidden="true" class="ml-hero-ribbons"></div>
<div aria-hidden="true" class="ml-hero-dots"></div>
<div class="ml-hero-inner">
<div class="ml-hero-copy">
<p class="ml-eyebrow">Tentang Organisasi</p>
<h1 class="ml-hero-title" id="mlHeroTitle"><span>Profil</span><span>TIDAR</span></h1>
<div aria-hidden="true" class="ml-hero-rule"></div>
<p class="ml-hero-lead">Mengenal identitas, nilai, dan perjalanan organisasi pemuda Tunas Indonesia Raya.</p>
</div>
<figure class="ml-garuda-panel">
<img alt="Garuda Pancasila, lambang negara Republik Indonesia" decoding="async" fetchpriority="high" height="1042" src="/assets/garuda-pancasila-authentic.webp" width="960"/>
<figcaption class="ml-garuda-caption"><span>Lambang Negara</span><span>Republik Indonesia</span></figcaption>
</figure>
</div>
</section>
<section aria-label="Profil organisasi TIDAR" class="profile-redesign-content">
<div class="profile-redesign-shell">
<div class="profile-redesign-intro">
<div class="profile-redesign-copy">
<p class="profile-redesign-label">Siapa Kami?</p>
<h2>Wadah aspirasi dan karya nyata generasi muda Indonesia.</h2>
<p>TIDAR adalah organisasi kepemudaan modern yang berakar pada Partai Gerindra. Kami berkomitmen menggerakkan dan mengembangkan potensi generasi muda Indonesia agar siap menjadi kekuatan perubahan yang berintegritas, berkarakter, dan berorientasi pada kepentingan bangsa.</p>
</div>
<div class="profile-redesign-logo-card">
<img alt="Logo Tunas Indonesia Raya" decoding="async" loading="lazy" src="/assets/logo-tidar-satin.jpg"/>
</div>
</div>
<div aria-label="Landasan gerakan TIDAR" class="profile-redesign-pillars">
<article class="profile-redesign-pillar">
<span class="profile-redesign-number">01</span>
<img alt="" aria-hidden="true" src="/assets/pillar-awal-bangsa.svg"/>
<h3>Awal Bangsa<br/>yang Kokoh</h3>
<p>Menanamkan nilai-nilai kebangsaan yang kuat sejak dini, berlandaskan nilai-nilai perjuangan dan persatuan.</p>
</article>
<article class="profile-redesign-pillar">
<span class="profile-redesign-number">02</span>
<img alt="" aria-hidden="true" src="/assets/pillar-lima-cinta.svg"/>
<h3>Lima Cinta</h3>
<p>Cinta Tuhan, cinta diri, cinta keluarga, cinta tanah air, dan cinta sesama manusia sebagai fondasi gerakan.</p>
</article>
<article class="profile-redesign-pillar">
<span class="profile-redesign-number">03</span>
<img alt="" aria-hidden="true" src="/assets/pillar-ruang-kontribusi.svg"/>
<h3>Ruang<br/>Kontribusi</h3>
<p>TIDAR membuka ruang bagi ide, aksi, dan karya nyata untuk memberi manfaat bagi masyarakat dan bangsa.</p>
</article>
</div>
<section aria-labelledby="rolesTitle" class="profile-redesign-roles">
<p class="profile-redesign-label" id="rolesTitle">Peran dan Gerakan TIDAR</p>
<div class="profile-redesign-roles__grid">
<article class="profile-redesign-role">
<span class="profile-redesign-role__icon"><img alt="" aria-hidden="true" src="/assets/role-pendidikan.svg"/></span>
<h3>Pendidikan</h3>
<p>Akses pendidikan berkualitas untuk generasi muda.</p>
</article>
<article class="profile-redesign-role">
<span class="profile-redesign-role__icon"><img alt="" aria-hidden="true" src="/assets/role-literasi.svg"/></span>
<h3>Literasi</h3>
<p>Menumbuhkan budaya membaca dan wawasan luas.</p>
</article>
<article class="profile-redesign-role">
<span class="profile-redesign-role__icon"><img alt="" aria-hidden="true" src="/assets/role-kepedulian-sosial.svg"/></span>
<h3>Kepedulian Sosial</h3>
<p>Mengakui berbagai solusi konkret atas kebutuhan.</p>
</article>
<article class="profile-redesign-role">
<span class="profile-redesign-role__icon"><img alt="" aria-hidden="true" src="/assets/role-kepemimpinan.svg"/></span>
<h3>Kepemimpinan</h3>
<p>Melalui pelatihan kepemimpinan untuk generasi muda.</p>
</article>
<article class="profile-redesign-role">
<span class="profile-redesign-role__icon"><img alt="" aria-hidden="true" src="/assets/role-olahraga-kreativitas.svg"/></span>
<h3>Olahraga, Seni &amp; Kreativitas</h3>
<p>Mengembangkan potensi di bidang olahraga, seni, dan kreativitas.</p>
</article>
</div>
</section>
<section aria-labelledby="fiveLoveTitle" class="profile-five">
<div class="profile-five-intro">
<div class="profile-five-copy">
<p class="profile-redesign-label">Filosofi Lima Cinta</p>
<h2 id="fiveLoveTitle">Lima nilai untuk membangun generasi muda yang kokoh.</h2>
<p>Filosofi Lima Cinta menjadi kerangka karakter TIDAR: pribadi yang bersyukur, menghargai sesama, terus belajar, menjunjung kesantunan, dan menjaga Indonesia.</p>
</div>
<div class="profile-five-banner">
<img alt="Lima Cinta Tunas Indonesia Raya" decoding="async" src="/assets/flash5cinta.png"/>
</div>
</div>
<div class="profile-five-grid">
<article class="profile-five-card">
<span class="profile-redesign-number">01</span>
<img alt="" aria-hidden="true" src="/assets/love-diri.svg"/>
<h3>Cinta Diri</h3>
<p>Mensyukuri nikmat Tuhan pada dirinya, berbesar hati menerima kekurangan sehingga bisa melihatnya sebagai potensi diri.</p>
</article>
<article class="profile-five-card">
<span class="profile-redesign-number">02</span>
<img alt="" aria-hidden="true" src="/assets/love-sesama.svg"/>
<h3>Cinta Sesama</h3>
<p>Menghargai dan menghormati sesama seperti kita mencintai diri sendiri.</p>
</article>
<article class="profile-five-card">
<span class="profile-redesign-number">03</span>
<img alt="" aria-hidden="true" src="/assets/love-belajar.svg"/>
<h3>Cinta Belajar</h3>
<p>Bersemangat tinggi untuk tidak pernah berhenti belajar.</p>
</article>
<article class="profile-five-card">
<span class="profile-redesign-number">04</span>
<img alt="" aria-hidden="true" src="/assets/love-kesantunan.svg"/>
<h3>Cinta Kesantunan</h3>
<p>Sopan, sabar, memiliki belas kasih dan suka menolong.</p>
</article>
<article class="profile-five-card">
<span class="profile-redesign-number">05</span>
<img alt="" aria-hidden="true" src="/assets/love-indonesia.svg"/>
<h3>Cinta Indonesia</h3>
<p>Kesadaran untuk memiliki dan mempertahankan identitas serta integritas bangsa secara nyata.</p>
</article>
</div>
</section>
</div>
</section>
</main>
</BaseLayout>
